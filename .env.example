# Server Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
SESSION_SECRET=super_secret_reachinbox_session_key_2026

# PostgreSQL Database Connection
DATABASE_URL="postgresql://reachinbox:reachinbox_secret_password@localhost:5432/reachinbox_db?schema=public"

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Slack OAuth Credentials
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:4000/api/auth/slack/callback

# Nodemailer / Ethereal SMTP Settings (Optional, auto-generated if empty)
ETHEREAL_USER=
ETHEREAL_PASS=

# Worker Settings
WORKER_CONCURRENCY=5
DEFAULT_HOURLY_LIMIT=50
DEFAULT_MIN_DELAY_MS=2000
